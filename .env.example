# Format: pageId[@date][:notify|book]  (default mode = book)
# Both notify immediately then hold, any date
MOVIE_TARGETS=952:book,954:book

# Contact used for the 10-minute hold (Click/Payme checkout)
BOOKING_EMAIL=test@gmail.com
BOOKING_PHONE=+998901234567

# Telegram bot — get from @BotFather, chat id from @userinfobot or group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Poll every N seconds while looking for seats
POLL_INTERVAL_SEC=30

# Only book showtimes starting in this window
TIME_FROM=19:00
TIME_TO=23:00

# Prefer IMAX / ATMOS / regular halls; set true to also try VIP
ALLOW_VIP=false

# imax | atmos (Avalon ATMOS only) | all
HALL_PREFERENCE=atmos

# Hold this many adjacent center seats
SEAT_COUNT=2

# Telegram ping when best seats appear, then attempt hold (book mode)
NOTIFY_BEFORE_HOLD=true

# true = scan only, never POST /payment/dis
DRY_RUN=true

# After book targets succeed, keep running if notify targets remain
STOP_ON_SUCCESS=true
