# Cinematica movie page id (Одиссея)
MOVIE_PAGE_ID=948

# Contact used for the 10-minute hold (Click/Payme checkout)
BOOKING_EMAIL=test@gmail.com
BOOKING_PHONE=+998901234567

# Telegram bot — get from @BotFather, chat id from @userinfobot or group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Poll every N seconds while looking for seats
POLL_INTERVAL_SEC=30

# Only book showtimes starting in this window (inclusive start, exclusive end hour 24 = midnight)
TIME_FROM=19:00
TIME_TO=00:00

# Prefer IMAX / ATMOS / regular halls; set true to also try VIP
ALLOW_VIP=false

# imax (default) | atmos | all — your seat numbers match IMAX center
HALL_PREFERENCE=imax

# true = scan only, never POST /payment/dis
DRY_RUN=true

# Stop after first successful hold
STOP_ON_SUCCESS=true
